// Zeroshow: proves a private achievement count meets a public threshold
// without revealing the actual count. See README.md for the full privacy model.

pragma language_version >= 0.16 && <= 0.34;

import CompactStandardLibrary;

export ledger verifiedCount: Counter;

witness completedTasks(): Uint<64>;

export circuit proveThreshold(threshold: Uint<64>): Boolean {
  const met = completedTasks() >= threshold;
  verifiedCount.increment(1);
  return disclose(met);
}
